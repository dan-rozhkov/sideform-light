{
  "name": "sideform-light",
  "version": "0.4.0",
  "license": "MIT",
  "description": "Sideform Light: an agent chat next to a built-in browser",
  "main": "dist/main/index.js",
  "private": true,
  "scripts": {
    "build:ts": "tsc",
    "copy-static": "node scripts/copy-static.mjs",
    "copy-backend": "node scripts/copy-backend.mjs",
    "build": "npm run build:ts && npm run copy-static && npm run copy-backend",
    "start": "npm run build && electron .",
    "dev": "SIDEFORM_LIGHT_SKIP_UI=1 SIDEFORM_LIGHT_UI_URL=http://localhost:5174 npm run start",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:e2e": "SIDEFORM_LIGHT_SKIP_UI=1 SIDEFORM_LIGHT_SKIP_BACKEND=1 npm run build && playwright test",
    "dist": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.sideform.light",
    "afterPack": "./scripts/verify-packaged-deps.cjs",
    "productName": "Sideform Light",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "THIRD_PARTY_NOTICES.md"
    ],
    "asarUnpack": [
      "dist/backend/**"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/app-icons/black.icon",
      "category": "public.app-category.graphics-design",
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/app-icons/black.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Sideform-Light-Setup-${version}.${ext}",
      "license": "build/installer-license.txt"
    }
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.1",
    "@sideform/browser-agent": "github:dan-rozhkov/browser-agent#v0.4.10",
    "playwright-core": "1.64.1"
  }
}
